<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-feature android:name="android.hardware.camera.any" android:required="true"/>
    <application android:name="com.daniil.wristlens.shared.WristLensApp" android:theme="@style/AppTheme" android:label="@string/app_name" android:icon="@drawable/ic_camera" android:roundIcon="@drawable/ic_camera" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".PhoneActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter><action android:name="android.intent.action.VIEW"/><category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/><data android:scheme="wristlens" android:host="phone"/></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".CameraService" android:exported="false" android:foregroundServiceType="camera|microphone"/>
        <service android:name=".MediaTransferService" android:exported="false"/>
        <service android:name=".MediaBridgeService" android:exported="true">
            <intent-filter><action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/><data android:scheme="wear" android:host="*" android:path="/wristlens/v2/media"/></intent-filter>
            <intent-filter><action android:name="com.google.android.gms.wearable.CHANNEL_EVENT"/><data android:scheme="wear" android:host="*" android:pathPrefix="/wristlens/v2/file/"/></intent-filter>
        </service>
    </application>
</manifest>
